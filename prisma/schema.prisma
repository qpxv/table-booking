generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  memberId      String?   @unique
  // Self-service, set in Einstellungen's "Zahlungsdetails" tab — powers the
  // SEPA payment QR in Gasthistorie. Never exposed to admins/other members.
  iban          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  // Set when an admin provisions the account or resets its password; the
  // app is gated behind a forced password change until the member clears
  // it themselves on first login.
  mustChangePassword Boolean @default(false)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  bookings           Booking[]
  guests             Guest[]
  participants       BookingParticipant[]
  drinkTallies       DrinkTally[]
  playerSearches     PlayerSearch[]
  playerSearchInterests PlayerSearchInterest[] @relation("InterestResponder")
  playerSearchProposals PlayerSearchInterest[] @relation("InterestProposedBy")
  createdEvents      Event[]
  eventParticipations EventParticipant[]
  pushSubscriptions  PushSubscription[]
  attendances        Attendance[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- Table booking -------------------------------------------------------

model Table {
  id                    String   @id @default(cuid())
  name                  String
  active                Boolean  @default(true)
  // "Mehrfachbuchung": a shared/community event slot multiple members can
  // join, instead of one member owning the slot exclusively.
  allowMultipleBookings Boolean  @default(false)
  // Rank in the Spielersuche auto-booking order (lower = tried first). null
  // means the table is never auto-booked. Admin-managed in Tischverwaltung.
  autoBookingPriority   Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  start     DateTime
  end       DateTime
  game      String?
  // Free-text note. Currently only set by Spielersuche auto-booking, where
  // it carries the responding member's message ("yo lass ma 2k chillig").
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  guests       BookingGuest[]
  participants BookingParticipant[]
  // Set for a booking that was auto-created from a group Spielersuche and is
  // still filling up (people join via "Mitmachen"). Cancelling the booking
  // cascades the still-open search away.
  playerSearch PlayerSearch?

  // Backs the overlap check: all bookings for a table within range X..Y.
  // Cancelling a booking hard-deletes it (no soft-delete/status field), so
  // every surviving row here is inherently active.
  @@index([tableId, start, end])
}

model Guest {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookings BookingGuest[]

  @@index([userId])
}

// Price is frozen (snapshotted) at booking creation time, not computed live.
model BookingGuest {
  id        String   @id @default(cuid())
  price     Decimal  @db.Decimal(10, 2)
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id])

  @@index([guestId])
}

// A member signed up to a shared ("Mehrfachbuchung") table's event. The
// creator is inserted as a participant too, so counting is uniform.
model BookingParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([bookingId])
}

// Admin-managed suggestion list for the "Spiel" field on bookings
// (Spielverwaltung). Deliberately not a relation to Booking — a booking's
// game stays a free-typed string, this just powers GameCombobox's
// suggestions, so renaming/deleting a game here never touches past bookings.
model Game {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An open "Spielersuche": a member looking for an opponent for a match in a
// given time window. Other members register interest (PlayerSearchInterest);
// when the creator accepts one, the app auto-books the first free table
// (Table.autoBookingPriority order).
//
// For a 1v1 search (`playerCount` 2) that first accept books the table and
// deletes this row. For a group search (`playerCount` > 2) the accept instead
// links the booking here (`bookingId`), drops every other pending interest,
// and the search stays open in a second phase: other members join the booking
// directly via "Mitmachen" until it is full, then this row is deleted.
model PlayerSearch {
  id        String   @id @default(cuid())
  // Total players wanted, including the creator (min 2). 2 is a classic 1v1
  // search; > 2 turns on the group / "Mitmachen" phase after the first booking.
  playerCount Int    @default(2)
  // Null when the creator left the time open ("flexibel"): the interested
  // member must then propose a concrete time on their PlayerSearchInterest.
  // Filled with the booked window once a group search enters its second phase.
  start     DateTime?
  end       DateTime?
  // Game system, free text from the same suggestion list as Booking.game
  // (Spielverwaltung), e.g. "40k", "30k", "Kill Team".
  system    String
  // Free text, e.g. "2000 Pkt, gemütlich", "Turniervorbereitung".
  matchType String
  // Whether an auto-bookable table (Table.autoBookingPriority) is currently
  // free for this whole window. Kept in sync by booking mutations (see
  // lib/queries/player-search-availability.ts); when it flips to false the
  // creator is pushed to pick another time. Only a hint for the UI warning:
  // acceptPlayerSearchInterest still re-checks under the advisory lock.
  // Always true (and never synced) for flexible searches: there is no window
  // to check until a concrete time lands on an interest.
  tableAvailable Boolean @default(true)
  // Bumped to now() whenever the creator confirms the search is still current
  // (initially = createdAt). The stale-check cron nags the creator once
  // `confirmedActiveAt` is older than 14 days; `staleNotifiedAt` de-dupes that
  // push and is cleared on the next confirmation.
  confirmedActiveAt DateTime @default(now())
  staleNotifiedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  // Null in phase 1 (still negotiating a first opponent). Set once the table
  // is booked and the group search is filling up. Cascade: cancelling the
  // booking removes the leftover search too.
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  interests PlayerSearchInterest[]

  @@index([start])
}

// A member registering interest in someone else's PlayerSearch, plus the
// running time negotiation for that pairing. `proposedStart`/`proposedEnd` is
// the currently-agreed-or-proposed window; `proposedById` is whoever set it
// last, so the *other* party is the one on the clock (accept / counter). The
// search creator accepts one (auto-books a table for `proposedStart/End`,
// deletes the search and cascades the rest away) or declines one.
model PlayerSearchInterest {
  id        String   @id @default(cuid())
  note      String?
  proposedStart DateTime
  proposedEnd   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchId String
  search   PlayerSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  responderId String
  responder   User   @relation("InterestResponder", fields: [responderId], references: [id])

  proposedById String
  proposedBy   User   @relation("InterestProposedBy", fields: [proposedById], references: [id])

  @@unique([searchId, responderId])
  @@index([searchId])
}

// A club event not tied to a physical table (e.g. "Schwimmen gehen"). Only
// admins create/edit/delete them; any member signs themselves up. The
// creator is NOT auto-added as a participant (unlike Booking).
model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  start       DateTime
  // Optional: some events have no fixed end time.
  end         DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  participants EventParticipant[]

  @@index([start])
}

model EventParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
}

// One Web Push subscription = one browser/device a member opted in on. A
// member can have several (phone + desktop). Pruned automatically when the
// push service reports the endpoint as gone (404/410) on a send.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A member marking themselves present at the club on a given calendar day
// ("Anwesenheit"). Day-granular, one row per member per day, toggled from
// the Anwesenheit month calendar. Members with a Booking that day are
// counted as present without a row here, so a row is never created while a
// booking already covers that member/day.
//
// `date` is the Berlin calendar day stored as UTC-midnight (Berlin is always
// UTC+1/+2, so formatting a UTC-midnight value in Europe/Berlin yields the
// same day back). Construct with `attendanceDayToDate` from lib/datetime.
model Attendance {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// Admin-set drink stock for a given calendar month (Getränke-Tracking).
model DrinkMonthlyBudget {
  id           String   @id @default(cuid())
  year         Int
  month        Int // 1-12
  initialCount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, month])
}

// Running per-member drink count for a calendar month. Drinks taken by a
// guest are rolled into the bringing member's own count, not tracked
// separately, since the admin report only needs one number per member.
model DrinkTally {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([year, month])
}
