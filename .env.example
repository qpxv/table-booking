# --- Datenbank (Neon Postgres) -------------------------------------------
# Wird zur Laufzeit von der App genutzt (pooled/PgBouncer-Connection-String aus Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Wird von Prisma Migrate/CLI genutzt (direkte/unpooled Connection-String aus Neon,
# nötig für Migrationen). In Neon: "Direct connection" statt "Pooled connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Better Auth -----------------------------------------------------------
# Generieren mit: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-openssl-rand--base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: email of an admin account to hide from Benutzerverwaltung
# (e.g. a personal dev/test account). Leave unset to hide nothing.
DEV_ACCOUNT_EMAIL=

# --- Web Push (VAPID) -----------------------------------------------------
# Generieren mit: npx tsx scripts/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:vorstand@dice-bock.de"
# Muss denselben Wert wie VAPID_PUBLIC_KEY haben (wird an den Client ausgeliefert).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Cron ----------------------------------------------------------------
# Bearer-Token, das der Vercel-Cron-Job (siehe vercel.json) mitschickt.
# Generieren mit: openssl rand -base64 32. In Vercel als Env-Var setzen.
CRON_SECRET=

# --- Discord Bot -----------------------------------------------------------
# Aus dem Discord Developer Portal (discord.com/developers/applications).
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Server-ID des Vereins-Discords (Rechtsklick auf das Server-Icon mit
# aktiviertem Entwicklermodus -> "Server-ID kopieren").
DISCORD_GUILD_ID=
# Kanäle für Ankündigungen, pro Kategorie getrennt (Rechtsklick auf den
# Kanal -> "Kanal-ID kopieren"). Jeder ist optional: ist eine ID nicht
# gesetzt, werden Ankündigungen dieser Kategorie stillschweigend übersprungen.
# App-Updates gehen in einen eigenen Kanal (per `npm run changelog:post`).
DISCORD_APP_UPDATE_CHANNEL_ID=1212543902960193536
# Optional: Rollen-ID der "@Mitglied"-Rolle (Servereinstellungen -> Rollen ->
# Rechtsklick -> "Rollen-ID kopieren"). Ist sie gesetzt, pingt `changelog:post`
# diese Rolle unter dem App-Update-Titel. Nicht der Rollenname, die ID.
DISCORD_MITGLIED_ROLE_ID=
DISCORD_BOOKING_CHANNEL_ID=
DISCORD_EVENT_CHANNEL_ID=
DISCORD_PLAYER_SEARCH_CHANNEL_ID=
